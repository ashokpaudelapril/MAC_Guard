# ─── Swift Package Manager ────────────────────────────────────────────────────
.build/
.swiftpm/
Package.pins

# Package.resolved IS checked in — it pins dependency versions so every
# contributor gets an identical build. (MacGuard has no external deps yet,
# so it may not exist. If it appears, track it.)

# ─── Xcode ────────────────────────────────────────────────────────────────────
# MacGuard is SPM-only. Do not commit generated Xcode projects.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# ─── macOS system files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
Icon$'\r'

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
# VS Code (swift extension settings are user-specific, not project config)
.vscode/

# JetBrains (AppCode, CLion)
.idea/
*.iml

# Nova
.nova/

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#
.#*

# ─── Build & test artifacts ───────────────────────────────────────────────────
# Xcode test result bundles
*.xcresult
.test_results/

# Crash and diagnostic reports generated during testing
*.ips
*.crash

# ─── Distribution artifacts ───────────────────────────────────────────────────
# Built by scripts/build-release.sh — never commit signed binaries or zips
dist/

# ─── Runtime files written by MacGuard itself ─────────────────────────────────
# The live log lives in ~/Library/Application Support/MacGuard/ at runtime.
# These entries are a safeguard in case someone symlinks or copies logs here.
history.log
history.log.1

# ─── Sensitive / environment files ────────────────────────────────────────────
# MacGuard has no API keys or .env files, but block them as a safety net.
.env
.env.*
*.pem
*.p12
*.cer

References/
